@* Hire me, as a wanted level going up. The stars and sirens are switched on by vice-city.js. *@
<StationSection Id="hire" Class="wanted-section">
  <div class="wanted-banner reveal">
    <div class="wanted-stars" id="wantedStars" aria-label="Wanted level: five stars">
      <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
    </div>
    <p class="wanted-kicker">Wanted level raised</p>
    <h2 class="wanted-title">Have a Project in Mind?</h2>
    <p class="availability"><span class="pulse-dot"></span> Available for work</p>
    <div class="services">
      @foreach (var service in PortfolioData.Services)
      {
        <span class="service-pill">@service</span>
      }
    </div>
    <div class="btn-row">
      <a href="#contact" class="btn btn-pink"><i class="fa-solid fa-envelope"></i> Get In Touch</a>
      <a href="@PortfolioData.UpworkUrl" target="_blank" rel="noopener" class="btn btn-navy">
        <i class="fa-brands fa-upwork"></i> Hire on Upwork
      </a>
    </div>
  </div>
</StationSection>
