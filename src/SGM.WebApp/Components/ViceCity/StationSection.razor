@* Section shell: id, station data attributes for the banner/radar, and the kicker + script heading. *@
<section class="section @Class" id="@Id" data-station="@Station.Freq" data-station-name="@Station.Label">
  <div class="container">
    @if (Title is not null)
    {
      <header class="section-head">
        <span class="section-kicker">@Station.GameName</span>
        <h2 class="section-title">@Title</h2>
      </header>
    }
    @ChildContent
  </div>
</section>

@code {

  [Parameter, EditorRequired]
  public required string Id { get; set; }

  [Parameter]
  public string? Class { get; set; }

  /// <summary>Script heading. Leave null when the section draws its own.</summary>
  [Parameter]
  public string? Title { get; set; }

  [Parameter]
  public RenderFragment? ChildContent { get; set; }

  private ViceCityStation Station => ViceCityStations.Get(Id);

}
