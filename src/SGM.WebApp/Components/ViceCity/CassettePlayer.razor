@* Floating tape deck. toggleVcMusic() in site.js plays sounds/vc-theme-music.m4a. *@
<button type="button" class="cassette-player cassette-floating" id="cassettePlayer" onclick="toggleVcMusic()" aria-label="Play or pause music">
  <span class="cassette-body">
    <span class="cassette-screw cassette-screw-tl"></span>
    <span class="cassette-screw cassette-screw-tr"></span>
    <span class="cassette-screw cassette-screw-bl"></span>
    <span class="cassette-screw cassette-screw-br"></span>
    <span class="cassette-label">
      <span class="cassette-label-lines"></span>
      <span class="cassette-title">VICE CITY FM</span>
      <span class="cassette-side">SIDE A &bull; 80s HITS</span>
    </span>
    <span class="cassette-window">
      <span class="cassette-reel cassette-reel-left"></span>
      <span class="cassette-tape"></span>
      <span class="cassette-reel cassette-reel-right"></span>
    </span>
    <span class="cassette-controls">
      <i class="fas fa-play" id="cassetteBtnIcon"></i>
    </span>
    <span class="cassette-holes">
      <span class="cassette-hole"></span>
      <span class="cassette-hole"></span>
      <span class="cassette-hole"></span>
    </span>
  </span>
</button>
