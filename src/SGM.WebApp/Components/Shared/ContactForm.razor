@* Plain server-rendered form (enhanced POST), so there is no live circuit to drop.
   site.js fills the hidden reCAPTCHA token on submit; the server verifies it in HandleSubmit. *@
<div class="contact-form">
  <EditForm Model="EmailInput" OnValidSubmit="HandleSubmit" FormName="contact" method="post" Enhance
            data-recaptcha-key="@CaptchaSiteKey">
    <DataAnnotationsValidator/>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
      <div class="status-message @(IsError ? "error" : "success")" role="status">
        <span class="status-icon">@(IsError ? "✗" : "✓")</span>
        @StatusMessage
      </div>
    }

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="contact-name">Name</label>
        <InputText @bind-Value="EmailInput!.Name" id="contact-name" class="form-input" placeholder="Your name..." autocomplete="name"/>
        <ValidationMessage For="@(() => EmailInput!.Name)" class="validation-error"/>
      </div>
      <div class="form-group">
        <label class="form-label" for="contact-email">Email</label>
        <InputText @bind-Value="EmailInput!.Email" id="contact-email" class="form-input" placeholder="Your email..." type="email" autocomplete="email"/>
        <ValidationMessage For="@(() => EmailInput!.Email)" class="validation-error"/>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="contact-subject">Subject</label>
      <InputText @bind-Value="EmailInput!.Subject" id="contact-subject" class="form-input" placeholder="Subject..." autocomplete="off"/>
      <ValidationMessage For="@(() => EmailInput!.Subject)" class="validation-error"/>
    </div>

    <div class="form-group">
      <label class="form-label" for="contact-message">Message</label>
      <InputTextArea @bind-Value="EmailInput!.Message" id="contact-message" class="form-input form-textarea" rows="5" placeholder="Your message..."/>
      <ValidationMessage For="@(() => EmailInput!.Message)" class="validation-error"/>
    </div>

    <InputText type="hidden" @bind-Value="EmailInput!.RecaptchaToken" data-recaptcha-token/>

    <button type="submit" class="btn btn-primary btn-glow">
      <span class="btn-loading" aria-hidden="true" hidden></span>
      <span class="btn-label">Send Message</span>
    </button>

    <p class="recaptcha-note">
      This site is protected by reCAPTCHA and the Google
      <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and
      <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Terms of Service</a> apply.
    </p>
  </EditForm>
</div>
