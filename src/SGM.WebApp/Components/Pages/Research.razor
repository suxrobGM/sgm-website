@page "/research"
@using System.Text.Json

<PageTitle>@Title</PageTitle>

<HeadContent>
  <meta name="description" content="@ResearchData.PageDescription" />
  <meta property="og:url" content="https://suxrobgm.net/research" />
  <meta property="og:title" content="@Title" />
  <meta property="og:description" content="@ResearchData.PageDescription" />
  <link rel="canonical" href="https://suxrobgm.net/research" />
  <link rel="stylesheet" href="css/research.css" />
</HeadContent>

<div class="rp">
  <div class="rp-inner">

    <header class="rp-head">
      <h1>Sukhrob Ilyosbekov</h1>
      <p class="rp-sub">Computer Vision &middot; Deep Learning &middot; Explainable AI</p>
      <p class="rp-affil">M.S. Computer Science, Northeastern University &middot; Boston, MA</p>
      <nav class="rp-links" aria-label="Profiles">
        <a href="mailto:@ResearchData.Email">
          <i class="fas fa-envelope" aria-hidden="true"></i> Email
        </a>
        <a href="@ResearchData.ScholarUrl" target="_blank" rel="noopener">
          <i class="fas fa-graduation-cap" aria-hidden="true"></i> Google Scholar
        </a>
        <a href="@ResearchData.GitHubUrl" target="_blank" rel="noopener">
          <i class="fab fa-github" aria-hidden="true"></i> GitHub
        </a>
        <a href="@ResearchData.LinkedInUrl" target="_blank" rel="noopener">
          <i class="fab fa-linkedin" aria-hidden="true"></i> LinkedIn
        </a>
      </nav>
      <div class="rp-cvs">
        <a class="rp-btn rp-btn-primary" href="resume-phd.pdf" target="_blank">
          <i class="fas fa-file-pdf" aria-hidden="true"></i> Research CV
        </a>
        <a class="rp-btn" href="resume-aiml.pdf" target="_blank">
          <i class="fas fa-file-pdf" aria-hidden="true"></i> ML Engineering Résumé
        </a>
      </div>
    </header>

    <section class="rp-statement" aria-label="Research statement">
      <p>@ResearchData.ResearchStatement</p>
    </section>

    <section aria-labelledby="publications">
      <h2 id="publications">Publications</h2>

      @foreach (var pub in ResearchData.Publications)
      {
        <article class="rp-pub">
          <h3>
            <a href="@pub.ArxivUrl" target="_blank" rel="noopener">@pub.Title</a>
          </h3>
          <p class="rp-authors">@BoldSelf(pub.Authors)</p>
          <p class="rp-venue">@pub.Venue &middot; arXiv:@pub.ArxivId</p>

          <TagList Tags="pub.Tags" />

          <p class="rp-actions">
            <a href="@pub.ArxivUrl" target="_blank" rel="noopener">
              <i class="fas fa-file-lines" aria-hidden="true"></i> Paper
            </a>
            @if (pub.RepoUrl is not null)
            {
              <a href="@pub.RepoUrl" target="_blank" rel="noopener">
                <i class="fab fa-github" aria-hidden="true"></i> Code
              </a>
            }
          </p>

          <details class="rp-details">
            <summary>Summary</summary>
            <p>@pub.Summary</p>
          </details>

          <details class="rp-details">
            <summary>BibTeX</summary>
            <pre><code>@pub.BibTex</code></pre>
          </details>
        </article>
      }
    </section>

    <section aria-labelledby="applied">
      <h2 id="applied">Applied Work</h2>
      <p class="rp-note">
        The same questions as above, but in systems that are running and handling real
        clinical or operational data.
      </p>

      @foreach (var proj in ResearchData.AppliedProjects)
      {
        <ProjectCard Project="proj" />
      }
    </section>

    <section aria-labelledby="coursework">
      <h2 id="coursework">Selected Coursework</h2>
      <p class="rp-note">
        Graduate course projects, kept separate from the published work above.
      </p>

      @foreach (var proj in ResearchData.CourseProjects)
      {
        <ProjectCard Project="proj" />
      }
    </section>

    <footer class="rp-foot">
      <p>
        <a href="mailto:@ResearchData.Email">@ResearchData.Email</a>
        &middot;
        <a href="/">Portfolio site</a>
      </p>
      <p class="rp-copy">&copy; @DateTime.UtcNow.Year Sukhrob Ilyosbekov</p>
    </footer>

  </div>
</div>

@* Emitted as raw markup because Razor encodes the "+" in the type attribute to &#x2B;. *@
@JsonLdScript

@code {

  private const string Title = "Sukhrob Ilyosbekov | Computer Vision Research";

  /// <summary>Inputs are static, never user data.</summary>
  private static MarkupString BoldSelf(string authors) =>
      (MarkupString)authors.Replace("S. Ilyosbekov", "<strong>S. Ilyosbekov</strong>");

  /// <summary>JsonSerializer escapes &lt; and &gt;, so the payload cannot break out.</summary>
  private static MarkupString JsonLdScript { get; } = (MarkupString)(
      """<script type="application/ld+json">""" + BuildJsonLd() + "</script>");

  private static string BuildJsonLd()
  {
    var person = new Dictionary<string, object?>
    {
      ["@context"] = "https://schema.org",
      ["@type"] = "Person",
      ["name"] = "Sukhrob Ilyosbekov",
      ["url"] = "https://suxrobgm.net/research",
      ["email"] = ResearchData.Email,
      ["jobTitle"] = "Machine Learning Engineer",
      ["alumniOf"] = new Dictionary<string, object?>
      {
        ["@type"] = "CollegeOrUniversity",
        ["name"] = "Northeastern University",
      },
      ["sameAs"] = new[] { ResearchData.ScholarUrl, ResearchData.GitHubUrl, ResearchData.LinkedInUrl },
      ["knowsAbout"] = new[]
      {
        "Computer Vision", "Deep Learning", "Explainable AI",
        "Medical Image Analysis", "Representation Learning",
      },
      ["subjectOf"] = ResearchData.Publications.Select(p => new Dictionary<string, object?>
      {
        ["@type"] = "ScholarlyArticle",
        ["headline"] = p.Title,
        ["author"] = "Sukhrob Ilyosbekov",
        ["url"] = p.ArxivUrl,
        ["identifier"] = $"arXiv:{p.ArxivId}",
      }).ToArray(),
    };

    return JsonSerializer.Serialize(person);
  }

}
