    <div class="xp-statusbar">
      <span class="xp-statusbar-section">6 programs installed</span>
      <span class="xp-statusbar-section">Total: All systems operational</span>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Experience Section - Windows Explorer Window -->
  <!-- ============================================================ -->
  <section class="xp-window" id="experience">
    <div class="xp-titlebar">
      <div class="xp-titlebar-left">
        <div class="xp-titlebar-icon"><i class="fas fa-briefcase"></i></div>
        <span class="xp-titlebar-text">Work Experience - Windows Explorer</span>
      </div>
      <div class="xp-window-controls">
        <span class="xp-btn-minimize">_</span>
        <span class="xp-btn-maximize">&#9723;</span>
        <span class="xp-btn-close">&#10005;</span>
