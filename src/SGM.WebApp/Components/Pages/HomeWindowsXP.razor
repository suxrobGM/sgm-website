    <div class="xp-titlebar">
      <div class="xp-titlebar-left">
        <div class="xp-titlebar-icon"><i class="fas fa-user"></i></div>
        <span class="xp-titlebar-text">About Me - System Properties</span>
      </div>
      <div class="xp-window-controls">
        <span class="xp-btn-minimize">_</span>
        <span class="xp-btn-maximize">&#9723;</span>
        <span class="xp-btn-close">&#10005;</span>
      </div>
    </div>
    <div class="xp-menubar">
      <span class="xp-menu-item">General</span>
      <span class="xp-menu-item">Computer Name</span>
      <span class="xp-menu-item">Hardware</span>
      <span class="xp-menu-item">Advanced</span>
    </div>
    <div class="xp-window-body">
      <div class="xp-about-grid">
        <div>
          <img src="images/about.jpg" alt="Sukhrob Ilyosbekov" class="xp-about-image">
        </div>
        <div class="xp-about-content">
          <h3>Hi, I'm Sukhrob</h3>
          <p>
            I write software for a living, mostly web products in .NET and TypeScript, and I do computer
            vision research alongside it, mainly in medical imaging. I got started by modding games back in
            Uzbekistan and have been building things ever since. These days I live in Portland, Maine, and have
            a Master's in Computer Science from Northeastern.
          </p>
          <p>
            Right now I work on software and machine learning for Alzheimer's care. It has taught me that a model
            nobody trusts doesn't get used, no matter how good its numbers look. Papers and code are on the <a href="/research">research page</a>.
          </p>
          <div class="xp-system-info">
            <div class="xp-system-info-row">
              <span class="xp-system-info-label">System:</span>
              <span class="xp-system-info-value">Sukhrob Ilyosbekov v9.0</span>
            </div>
            <div class="xp-system-info-row">
              <span class="xp-system-info-label">Role:</span>
              <span class="xp-system-info-value">Senior Full Stack Developer | AI Researcher</span>
            </div>
            <div class="xp-system-info-row">
              <span class="xp-system-info-label">Location:</span>
              <span class="xp-system-info-value">Portland, ME</span>
            </div>
            <div class="xp-system-info-row">
              <span class="xp-system-info-label">Education:</span>
              <span class="xp-system-info-value">M.S. Computer Science, Northeastern University</span>
            </div>
          </div>
          <div class="xp-stats-row">
            <div class="xp-stat-item">
              <div class="xp-stat-number">9+</div>
              <div class="xp-stat-label">Years Experience</div>
            </div>
            <div class="xp-stat-item">
              <div class="xp-stat-number">50+</div>
              <div class="xp-stat-label">Projects Completed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="xp-statusbar">
      <span class="xp-statusbar-section"><i class="fas fa-info-circle"></i> System Properties loaded successfully</span>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Hire Me CTA - Windows Update Window -->
  <!-- ============================================================ -->
  <section class="section" id="hire">
    <div class="xp-window xp-hire-window">
      <div class="xp-titlebar">
        <div class="xp-titlebar-text">
          <img src="/images/windows-xp-icon.png" alt="" class="xp-titlebar-icon" /> Windows Update - Available for Work
        </div>
        <div class="xp-titlebar-controls">
          <button class="xp-btn-minimize">_</button>
          <button class="xp-btn-maximize">□</button>
          <button class="xp-btn-close">×</button>
        </div>
      </div>
      <div class="xp-window-body xp-hire-body">
        <div class="xp-hire-icon">
          <i class="fa-solid fa-shield-halved" style="font-size: 48px; color: #316ac5;"></i>
        </div>
        <div class="xp-hire-content">
          <div class="xp-availability-badge">
            <span class="xp-status-dot"></span> Available for Work
          </div>
          <h3>Have a project in mind?</h3>
          <div class="xp-services-list">
            <span class="xp-service-item">✓ Full-Stack Development</span>
            <span class="xp-service-item">✓ Machine Learning</span>
            <span class="xp-service-item">✓ Game Development</span>
          </div>
          <div class="xp-hire-buttons">
            <a href="/xp#contact" class="xp-btn xp-btn-primary">
              <i class="fa-solid fa-envelope"></i> Get In Touch
            </a>
            <a href="https://www.upwork.com/freelancers/suxrobgm" target="_blank" class="xp-btn xp-btn-default">
              <i class="fa-brands fa-upwork"></i> Hire on Upwork
            </a>
