@page "/xp"
@inherits HomePageBase
@code {
  // Rendered twice below, as <PageTitle> and as og:title.
  private const string Title = "Sukhrob Ilyosbekov | ML Engineer (Windows XP)";

  private static readonly string[] ExplorerMenu = ["File", "Edit", "View", "Favorites", "Tools", "Help"];

  private sealed record DesktopIcon(string Label, string Href, string Icon, string? Color = null, bool External = false);

  private DesktopIcon[] DesktopIcons =>
  [
    new("About Me", "#about", "fas fa-user"),
    new("Industry Resume", AssetVersion.Url("resume.pdf"), "fas fa-file-pdf", "#e74c3c", true),
    new("Research CV", AssetVersion.Url("resume-phd.pdf"), "fas fa-file-pdf", "#e74c3c", true),
    new("My Skills", "#skills", "fas fa-code"),
    new("Experience", "#experience", "fas fa-briefcase", "#f0c040"),
    new("Research", "#research", "fas fa-microscope", "#a0d0f0"),
    new("My Projects", "#projects", "fas fa-folder", "#f0c040"),
    new("Education", "#education", "fas fa-graduation-cap", "#a0d0f0"),
    new("Hire Me", "#hire", "fas fa-shield-halved", "#316ac5"),
    new("Contact Me", "#contact", "fas fa-envelope", "#f0f0f0"),
    new("GitHub", "https://github.com/suxrobgm", "fab fa-github", External: true),
    new("LinkedIn", "https://linkedin.com/in/suxrobgm", "fab fa-linkedin", "#0077b5", true),
  ];

  /// <summary>"Add or Remove Programs" progress bars, by skill group name.</summary>
  private static readonly Dictionary<string, int> Proficiency = new()
  {
    ["AI & Deep Learning"] = 90,
    ["Backend Development"] = 95,
    ["Frontend Development"] = 92,
    ["Mobile & Desktop"] = 85,
    ["Game Development"] = 80,
    ["Cloud & DevOps"] = 88,
  };

  /// <summary>Folder icon and color per project slug.</summary>
  private static readonly Dictionary<string, (string Icon, string Color)> FolderIcons = new()
  {
    ["logisticsx"] = ("fas fa-truck", "#3a6ea5"),
    ["jobpilot"] = ("fas fa-paper-plane", "#ff6a3d"),
    ["meatgg"] = ("fas fa-gamepad", "#7b4bd8"),
    ["depvault"] = ("fas fa-lock", "#d4a017"),
    ["medscanner"] = ("fas fa-heartbeat", "#d9342b"),
    ["bookshelf"] = ("fas fa-book", "#2e9e44"),
  };

  private static int PaperCount => PortfolioData.Research.Count(r => r.PaperUrl is not null);
}

<PageTitle>@Title</PageTitle>

<HeadContent>
  <meta name="description" content="@Description" />
  <meta property="og:title" content="@Title" />
  <meta property="og:description" content="@Description" />
  <meta property="og:url" content="https://suxrobgm.net/xp" />
  <link rel="stylesheet" href="@AssetVersion.Url("css/windows-xp.css")" />
</HeadContent>

@* Startup sound and taskbar clock are started from site.js when #xpClock is on the page. *@

<!-- Bliss Wallpaper Background -->
<div class="xp-bliss-bg"></div>

<!-- Desktop Area (Hero) -->
<div class="xp-desktop" id="home">
  <div class="xp-desktop-icon">
    <img src="images/about.jpg" class="xp-icon-img" alt="Profile">
    <span class="xp-icon-label">@PortfolioData.FullName</span>
  </div>
  @foreach (var icon in DesktopIcons)
  {
    <a href="@icon.Href" target="@(icon.External ? "_blank" : null)" rel="@(icon.External ? "noopener" : null)"
       class="xp-desktop-icon" style="text-decoration:none;">
      <i class="@icon.Icon xp-icon-graphic" style="@(icon.Color is null ? null : $"color:{icon.Color};")"></i>
      <span class="xp-icon-label">@icon.Label</span>
    </a>
  }
</div>

<!-- Main Content Area -->
<div class="xp-content-area">

  <!-- About - System Properties -->
  <XpWindow Id="about" Icon="fas fa-user" Title="About Me - System Properties" Menu="@(["General", "Computer Name", "Hardware", "Advanced"])">
    <ChildContent>
      <div class="xp-window-body">
        <div class="xp-about-grid">
          <div>
            <img src="images/about.jpg" alt="Sukhrob Ilyosbekov" class="xp-about-image">
          </div>
          <div class="xp-about-content">
            <h3>Hi, I'm Sukhrob</h3>
            @foreach (var paragraph in PortfolioData.About)
            {
              <p>@((MarkupString)paragraph)</p>
            }
            <div class="xp-system-info">
              <div class="xp-system-info-row">
                <span class="xp-system-info-label">System:</span>
                <span class="xp-system-info-value">@PortfolioData.FullName v9.0</span>
              </div>
              <div class="xp-system-info-row">
                <span class="xp-system-info-label">Role:</span>
                <span class="xp-system-info-value">@PortfolioData.Tagline</span>
              </div>
              <div class="xp-system-info-row">
                <span class="xp-system-info-label">Location:</span>
                <span class="xp-system-info-value">Portland, ME</span>
              </div>
              <div class="xp-system-info-row">
                <span class="xp-system-info-label">Education:</span>
                <span class="xp-system-info-value">M.S. Computer Science, Northeastern University</span>
              </div>
            </div>
            <div class="xp-stats-row">
              <div class="xp-stat-item">
                <div class="xp-stat-number">9+</div>
                <div class="xp-stat-label">Years Experience</div>
              </div>
              <div class="xp-stat-item">
                <div class="xp-stat-number">50+</div>
                <div class="xp-stat-label">Projects Completed</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </ChildContent>
    <Status>
      <span class="xp-statusbar-section"><i class="fas fa-info-circle"></i> System Properties loaded successfully</span>
    </Status>
  </XpWindow>

  <!-- Hire Me - Windows Update -->
  <XpWindow Id="hire" Class="xp-hire-window" Icon="fas fa-shield-halved" Title="Windows Update - Available for Work">
    <div class="xp-window-body xp-hire-body">
      <div class="xp-hire-icon">
        <i class="fa-solid fa-shield-halved" style="font-size: 48px; color: #316ac5;"></i>
      </div>
      <div class="xp-hire-content">
        <div class="xp-availability-badge">
          <span class="xp-status-dot"></span> Available for Work
        </div>
        <h3>Have a project in mind?</h3>
        <div class="xp-services-list">
          @foreach (var service in PortfolioData.Services)
          {
            <span class="xp-service-item">✓ @service</span>
          }
        </div>
        <div class="xp-hire-buttons">
          <a href="#contact" class="xp-btn xp-btn-primary"><i class="fa-solid fa-envelope"></i> Get In Touch</a>
          <a href="@PortfolioData.UpworkUrl" target="_blank" rel="noopener" class="xp-btn xp-btn-default">
            <i class="fa-brands fa-upwork"></i> Hire on Upwork
          </a>
        </div>
      </div>
    </div>
  </XpWindow>

  <!-- Skills - Add or Remove Programs -->
  <XpWindow Id="skills" Icon="fas fa-code" Title="Tech Stack - Add or Remove Programs"
            Menu="@(["Change or Remove Programs", "Add New Programs", "Add/Remove Windows Components"])">
    <ChildContent>
      <div class="xp-window-body" style="padding: 0;">
        <div class="xp-infobar">
          <i class="fas fa-info-circle"></i>
          Currently installed programs. To change or remove a program, click its entry.
        </div>
        <div class="xp-list-header">
          <div class="xp-list-header-item" style="flex: 1;">Name</div>
          <div class="xp-list-header-item" style="width: 200px;">Technologies</div>
          <div class="xp-list-header-item" style="width: 120px;">Proficiency</div>
        </div>
        <div class="xp-program-list">
          @foreach (var group in PortfolioData.Skills)
          {
            <div class="xp-program-item">
              <div class="xp-program-icon"><i class="@group.Icon"></i></div>
              <div class="xp-program-info">
                <div class="xp-program-name">@group.Name</div>
                <div class="xp-program-tags">
                  @foreach (var skill in group.Skills)
                  {
                    <span>@skill</span>
                  }
                </div>
              </div>
              <div class="xp-progress-bar xp-progress-animated">
                <div class="xp-progress-fill" style="width: @(Proficiency[group.Name])%;"></div>
              </div>
            </div>
          }
        </div>
      </div>
    </ChildContent>
    <Status>
      <span class="xp-statusbar-section">@PortfolioData.Skills.Count programs installed</span>
      <span class="xp-statusbar-section">Total: All systems operational</span>
    </Status>
  </XpWindow>

  <!-- Experience - Windows Explorer -->
  <XpWindow Id="experience" Icon="fas fa-briefcase" Title="Work Experience - Windows Explorer" Menu="ExplorerMenu">
    <ChildContent>
      <div class="xp-toolbar">
        <span class="xp-toolbar-btn"><i class="fas fa-arrow-left"></i> Back</span>
        <span class="xp-toolbar-btn"><i class="fas fa-arrow-right"></i></span>
        <span class="xp-toolbar-btn"><i class="fas fa-arrow-up"></i></span>
        <span class="xp-toolbar-separator"></span>
        <span class="xp-toolbar-btn"><i class="fas fa-search"></i> Search</span>
        <span class="xp-toolbar-btn"><i class="fas fa-folder"></i> Folders</span>
      </div>
      <div class="xp-addressbar">
        <span class="xp-addressbar-label">Address</span>
        <div class="xp-addressbar-icon"><i class="fas fa-briefcase"></i></div>
        <span class="xp-addressbar-input">C:\Career\Work Experience</span>
      </div>
      <div class="xp-explorer-layout">
        <div class="xp-explorer-sidebar">
          <ul class="xp-tree">
            <li>
              <div class="xp-tree-item">
                <span class="xp-tree-toggle">-</span>
                <i class="fas fa-desktop xp-tree-icon" style="color:#3a6ea5;"></i>
                <span class="xp-tree-label">My Computer</span>
              </div>
              <ul>
                <li>
                  <div class="xp-tree-item">
                    <span class="xp-tree-toggle">-</span>
                    <i class="fas fa-hdd xp-tree-icon" style="color:#888;"></i>
                    <span class="xp-tree-label">C:\Career</span>
                  </div>
                  <ul>
                    <li>
                      <div class="xp-tree-item selected">
                        <span class="xp-tree-toggle">-</span>
                        <i class="fas fa-folder-open xp-tree-icon"></i>
                        <span class="xp-tree-label">Work Experience</span>
                      </div>
                      <ul>
                        @foreach (var job in PortfolioData.Jobs)
                        {
                          <li>
                            <div class="xp-tree-item"><i class="fas fa-folder xp-tree-icon"></i> <span class="xp-tree-label">@job.Company</span></div>
                          </li>
                        }
                      </ul>
                    </li>
                  </ul>
                </li>
              </ul>
            </li>
          </ul>
        </div>
        <div class="xp-explorer-main">
          @for (var i = 0; i < PortfolioData.Jobs.Count; i++)
          {
            var job = PortfolioData.Jobs[i];
            if (i > 0)
            {
              <hr class="xp-job-separator">
            }
            <div class="xp-detail-pane">
              <div class="xp-job-header">
                <div>
                  <div class="xp-job-title">@job.Title</div>
                  <div class="xp-job-company">@job.Company | @job.Location</div>
                </div>
                <span class="xp-job-date">@job.Period</span>
              </div>
              <div class="xp-job-description">@job.Summary</div>
            </div>
          }
        </div>
      </div>
    </ChildContent>
    <Status>
      <span class="xp-statusbar-section">@PortfolioData.Jobs.Count objects</span>
      <span class="xp-statusbar-section"><i class="fas fa-briefcase"></i> Work Experience</span>
    </Status>
  </XpWindow>

  <!-- Research - Scientific Tools -->
  <XpWindow Id="research" Icon="fas fa-microscope" Title="Research & Projects - Scientific Tools">
    <ChildContent>
      <div class="xp-window-body" style="padding: 0;">
        <div class="xp-infobar">
          <i class="fas fa-flask"></i>
          Papers and projects in computer vision and medical imaging.
          <a href="/research">Open the full research page</a>
        </div>
        <ul class="xp-research-list">
          @foreach (var item in PortfolioData.Research)
          {
            <li class="xp-research-item">
              <div class="xp-research-icon"><i class="@item.Icon"></i></div>
              <div class="xp-research-content">
                <div class="xp-research-title">@item.Title</div>
                <div class="xp-research-desc">@item.Summary</div>
                <div class="xp-research-tags">
                  @foreach (var tag in item.Tags)
                  {
                    <span>@tag</span>
                  }
                </div>
                <div class="xp-research-links">
                  @if (item.RepoUrl is not null)
                  {
                    <a href="@item.RepoUrl" target="_blank" rel="noopener"><i class="fab fa-github"></i> View Repository</a>
                  }
                  @if (item.PaperUrl is not null)
                  {
                    <a href="@item.PaperUrl" target="_blank" rel="noopener"><i class="fas fa-file-alt"></i> arXiv Paper</a>
                  }
                </div>
              </div>
            </li>
          }
        </ul>
      </div>
    </ChildContent>
    <Status>
      <span class="xp-statusbar-section">@PaperCount publications, @(PortfolioData.Research.Count - PaperCount) projects</span>
      <span class="xp-statusbar-section"><i class="fas fa-microscope"></i> Active Research</span>
    </Status>
  </XpWindow>

  <!-- Projects - My Documents -->
  <XpWindow Id="projects" Icon="fas fa-folder" Title="Featured Projects - My Documents" Menu="ExplorerMenu">
    <ChildContent>
      <div class="xp-toolbar">
        <span class="xp-toolbar-btn"><i class="fas fa-arrow-left"></i> Back</span>
        <span class="xp-toolbar-btn"><i class="fas fa-arrow-right"></i></span>
        <span class="xp-toolbar-separator"></span>
        <span class="xp-toolbar-btn"><i class="fas fa-th-large"></i> Icons</span>
        <span class="xp-toolbar-btn"><i class="fas fa-list"></i> Details</span>
      </div>
      <div class="xp-addressbar">
        <span class="xp-addressbar-label">Address</span>
        <div class="xp-addressbar-icon"><i class="fas fa-folder"></i></div>
        <span class="xp-addressbar-input">C:\Users\Sukhrob\My Documents\Projects</span>
      </div>
      <div class="xp-window-body" style="padding: 0;">
        <div class="xp-folder-grid">
          @foreach (var project in PortfolioData.Projects)
          {
            var (icon, color) = FolderIcons[project.Slug];
            <a href="@(project.SiteUrl ?? project.RepoUrl)" target="_blank" rel="noopener" class="xp-folder-item" style="text-decoration:none;">
              <i class="@icon xp-folder-icon" style="color:@color;"></i>
              <span class="xp-folder-label">@project.Title</span>
            </a>
          }
        </div>
        @for (var i = 0; i < PortfolioData.Projects.Count; i++)
        {
          var project = PortfolioData.Projects[i];
          if (i > 0)
          {
            <hr class="xp-divider" style="margin: 0;">
          }
          <div class="xp-project-detail">
            @if (project.Screenshot is not null)
            {
              <img src="@project.Screenshot" alt="@project.Title" class="xp-project-detail-img" loading="lazy" />
            }
            <div class="xp-project-detail-body">
              <div class="xp-project-detail-title">@project.Title</div>
              <div class="xp-project-detail-desc">@project.Summary</div>
              <div class="xp-project-tech-tags">
                @foreach (var tag in project.Tags)
                {
                  <span>@tag</span>
                }
              </div>
              <div class="xp-research-links">
                @if (project.SiteUrl is not null)
                {
                  <a href="@project.SiteUrl" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> Live Site</a>
                }
                @if (project.RepoUrl is not null)
                {
                  <a href="@project.RepoUrl" target="_blank" rel="noopener"><i class="fab fa-github"></i> GitHub</a>
                }
              </div>
            </div>
          </div>
        }
      </div>
    </ChildContent>
    <Status>
      <span class="xp-statusbar-section">@PortfolioData.Projects.Count objects</span>
      <span class="xp-statusbar-section"><i class="fas fa-folder"></i> My Documents</span>
    </Status>
  </XpWindow>

  <!-- Education - Academic Records -->
  <XpWindow Id="education" Icon="fas fa-graduation-cap" Title="Education - Academic Records">
    <ChildContent>
      <div class="xp-window-body">
        <div class="xp-education-grid">
          @foreach (var degree in PortfolioData.Education)
          {
            <div class="xp-education-card">
              <div class="xp-education-degree">
                <i class="fas fa-university" style="color: var(--xp-title-blue-light); margin-right: 6px;"></i>@degree.Title
              </div>
              <div class="xp-education-school">@degree.School</div>
              <div class="xp-education-date">@degree.Period</div>
              @if (degree.Note is not null)
              {
                <span class="xp-education-gpa">@degree.Note</span>
              }
            </div>
          }
        </div>
      </div>
    </ChildContent>
    <Status>
      <span class="xp-statusbar-section">@PortfolioData.Education.Count records</span>
      <span class="xp-statusbar-section"><i class="fas fa-graduation-cap"></i> Academic Records</span>
    </Status>
  </XpWindow>

  <!-- Contact - Send Message dialog -->
  <XpWindow Id="contact" Icon="fas fa-envelope" Title="Get In Touch - Send Message">
    <div class="xp-window-body">
      <div class="xp-welcome-banner">
        <i class="fas fa-envelope-open-text" style="font-size: 28px;"></i>
        <div>
          <h3>Say Hello</h3>
          <p>Use the form, or reach me by email, LinkedIn, or Telegram.</p>
        </div>
      </div>
      <div class="xp-dialog-body">
        <div class="xp-contact-info-column">
          <div class="xp-groupbox">
            <span class="xp-groupbox-title">Contact Information</span>
            <ul class="xp-contact-info-list">
              @foreach (var link in PortfolioData.Contacts)
              {
                var external = link.Url.StartsWith("http");
                <li class="xp-contact-info-item">
                  <div class="xp-contact-info-icon"><i class="@link.Icon"></i></div>
                  <div class="xp-contact-info-text">
                    <p>@link.Label</p>
                    <a href="@link.Url" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">@link.Display</a>
                  </div>
                </li>
              }
            </ul>
          </div>
        </div>
        <div class="xp-contact-form-wrapper">
          <div class="xp-groupbox">
            <span class="xp-groupbox-title">Send a Message</span>
            <ContactForm CaptchaSiteKey="@CaptchaSiteKey" />
          </div>
        </div>
      </div>
    </div>
  </XpWindow>

  <!-- Footer -->
  <div class="xp-footer">
    <div class="xp-footer-logo">SUKHROB.DEV</div>
    <div class="xp-social-links">
      @foreach (var link in PortfolioData.Socials)
      {
        <a href="@link.Url" target="_blank" rel="noopener" aria-label="@link.Label"><i class="@link.Icon"></i></a>
      }
    </div>
    <p class="xp-footer-copyright">&copy; @CurrentYear @PortfolioData.FullName. All rights reserved.</p>
  </div>
</div>

<ThemeSwitcher CurrentTheme="xp" />

<!-- Taskbar (replaces a traditional navbar) -->
<div class="xp-taskbar">
  <a href="#home" class="xp-start-btn" aria-label="Back to top">
    <img src="images/windows-xp-icon.png" alt="" class="xp-start-icon" />
    <span class="xp-start-text">start</span>
  </a>
  <div class="xp-quick-launch">
    <a href="#about" title="About Me"><i class="fas fa-user"></i></a>
    <a href="#skills" title="Skills"><i class="fas fa-code"></i></a>
    <a href="#experience" title="Experience"><i class="fas fa-briefcase"></i></a>
    <a href="#hire" title="Hire Me"><i class="fas fa-shield-halved"></i></a>
    <a href="#research" title="Research"><i class="fas fa-microscope"></i></a>
    <a href="#projects" title="Projects"><i class="fas fa-folder"></i></a>
    <a href="#education" title="Education"><i class="fas fa-graduation-cap"></i></a>
    <a href="#contact" title="Contact"><i class="fas fa-envelope"></i></a>
  </div>
  <div class="xp-task-area">
    <a href="#about" class="xp-task-btn"><i class="fas fa-user"></i> System Properties</a>
    <a href="#skills" class="xp-task-btn"><i class="fas fa-code"></i> Add/Remove Programs</a>
    <a href="#hire" class="xp-task-btn"><i class="fas fa-shield-halved"></i> Windows Update</a>
    <a href="#experience" class="xp-task-btn"><i class="fas fa-briefcase"></i> Explorer</a>
    <a href="#projects" class="xp-task-btn"><i class="fas fa-folder"></i> My Documents</a>
    <a href="#contact" class="xp-task-btn"><i class="fas fa-envelope"></i> Send Message</a>
  </div>
  <div class="xp-system-tray">
    <a href="https://github.com/suxrobgm" target="_blank" rel="noopener" title="GitHub"><i class="fab fa-github"></i></a>
    <a href="https://linkedin.com/in/suxrobgm" target="_blank" rel="noopener" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
    <span class="xp-clock" id="xpClock">12:00 PM</span>
  </div>
</div>
