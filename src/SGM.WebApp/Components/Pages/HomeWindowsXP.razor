@page "/xp"
@rendermode InteractiveServer
@inherits HomePageBase
@code {
  // Rendered twice below, as <PageTitle> and as og:title.
  private const string Title = "Sukhrob Ilyosbekov | ML Engineer (Windows XP)";
}

<PageTitle>@Title</PageTitle>

<HeadContent>
  <meta name="description" content="@Description" />
  <meta property="og:title" content="@Title" />
  <meta property="og:description" content="@Description" />
  <meta property="og:url" content="https://suxrobgm.net/xp" />
  <link rel="stylesheet" href="css/windows-xp.css" />
</HeadContent>

<!-- Bliss Wallpaper Background -->
<div class="xp-bliss-bg"></div>

<!-- Desktop Area (Hero) -->
<div class="xp-desktop" id="home">
  <div class="xp-desktop-icon">
    <img src="images/about.jpg" class="xp-icon-img" alt="Profile">
    <span class="xp-icon-label">Sukhrob Ilyosbekov</span>
  </div>
  <a href="/xp#about" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-user xp-icon-graphic"></i>
    <span class="xp-icon-label">About Me</span>
  </a>
  <a href="@Assets.Url("resume.pdf")" target="_blank" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-file-pdf xp-icon-graphic" style="color:#e74c3c;"></i>
    <span class="xp-icon-label">Industry Resume</span>
  </a>
  <a href="@Assets.Url("resume-phd.pdf")" target="_blank" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-file-pdf xp-icon-graphic" style="color:#e74c3c;"></i>
    <span class="xp-icon-label">Research CV</span>
  </a>
  <a href="/xp#skills" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-code xp-icon-graphic"></i>
    <span class="xp-icon-label">My Skills</span>
  </a>
  <a href="/xp#experience" class="xp-desktop-icon" style="text-decoration:none;">
