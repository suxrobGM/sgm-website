  </a>
  <a href="/xp#projects" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-folder xp-icon-graphic" style="color:#f0c040;"></i>
    <span class="xp-icon-label">My Projects</span>
  </a>
  <a href="/xp#education" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-graduation-cap xp-icon-graphic" style="color:#a0d0f0;"></i>
    <span class="xp-icon-label">Education</span>
  </a>
  <a href="/xp#hire" class="xp-desktop-icon" style="text-decoration:none;">
    <i class="fas fa-shield-halved xp-icon-graphic" style="color:#316ac5;"></i>
    <span class="xp-icon-label">Hire Me</span>
  </a>
  <a href="/xp#testimonials" class="xp-desktop-icon" style="text-decoration:none;">
