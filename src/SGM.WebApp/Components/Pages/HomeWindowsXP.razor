              <span>WPF</span>
              <span>Avalonia</span>
            </div>
          </div>
          <div class="xp-progress-bar xp-progress-animated">
            <div class="xp-progress-fill" style="width: 85%;"></div>
          </div>
        </div>
        <!-- Game Development -->
        <div class="xp-program-item">
          <div class="xp-program-icon"><i class="fas fa-gamepad"></i></div>
