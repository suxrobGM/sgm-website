@page "/"
@inherits HomePageBase
@code {
  // Rendered twice below, as <PageTitle> and as og:title.
  private const string Title = "Sukhrob Ilyosbekov | Machine Learning Engineer & CV Researcher";
}

<PageTitle>@Title</PageTitle>

<HeadContent>
  <meta name="description" content="@Description" />
  <meta property="og:title" content="@Title" />
  <meta property="og:description" content="@Description" />
  <meta property="og:url" content="https://suxrobgm.net/" />
  <link rel="preload" as="image" href="images/vc/vc-hero-desktop.webp" media="(min-width: 769px), (orientation: landscape)" fetchpriority="high" />
  <link rel="preload" as="image" href="images/vc/vc-hero-mobile.webp" media="(max-width: 768px) and (orientation: portrait)" fetchpriority="high" />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@500;600;700&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Mr+Dafoe&family=Permanent+Marker&family=VT323&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@AssetVersion.Url("css/vice-city.css")" />
</HeadContent>

@* Section components live in Components/ViceCity; their content comes from Data/PortfolioData.cs.
   Behavior (HUD, radar, menu, reveals) is in wwwroot/js/vice-city.js. *@
<div class="vc" data-vc>
  <div class="vc-grain" aria-hidden="true"></div>
  <Hud />
  <PauseMenu />

  <main>
    <Hero />
    <StatsSection />
    <WantedSection />
    <LoadoutSection />
    <MissionsSection />
    <TapesSection />
    <PropertiesSection />
    <SavesSection />
    <PayphoneSection CaptchaSiteKey="@CaptchaSiteKey" />
  </main>

  <Footer />
  <CassettePlayer />
</div>
