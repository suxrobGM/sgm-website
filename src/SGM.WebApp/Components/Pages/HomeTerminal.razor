      <h1 class="hero-title typing-container">
        <span class="first-name prompt">Sukhrob Ilyosbekov</span>
      </h1>
      <p class="hero-tagline">
        <span class="prompt">Senior Full Stack Developer | AI & Computer Vision Researcher</span>
      </p>
