                  <div class="stat-label">years_experience</div>
                </div>
                <div class="stat-item">
                  <div class="stat-number">50+</div>
                  <div class="stat-label">projects_completed</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
