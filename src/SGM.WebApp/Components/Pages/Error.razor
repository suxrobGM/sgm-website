@page "/Error"
@using System.Diagnostics

<PageTitle>Error | Sukhrob Ilyosbekov</PageTitle>

<HeadContent>
  <meta name="robots" content="noindex" />
</HeadContent>

<GameOver Title="Busted" Message="Something went wrong on the server. Please try again in a moment.">
  @if (!string.IsNullOrEmpty(RequestId))
  {
    <p class="game-over-request">Request ID: <code>@RequestId</code></p>
  }
</GameOver>

@code {

  [CascadingParameter]
  private HttpContext? HttpContext { get; set; }

  private string? RequestId => Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}
