{
  "editor.formatOnSave": true,
  "files.exclude": {
    ".vs": true,
    "**/bin": true,
    "**/obj": true,
    "**/Logs": true,
    "**/.idea": true
  },
  "[latex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[tex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[bibtex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  }
}
